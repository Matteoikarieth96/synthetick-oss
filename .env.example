# SyntheTick: environment variables.
# Copy to .env and fill in real values. Never commit .env (it is gitignored).
# Minimum to run the app locally: the four REQUIRED values below.

# ---- REQUIRED ---------------------------------------------------------------
# Supabase project (free tier works). The service key bypasses RLS: server only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Voyage AI embeddings (free tier is 3 requests/minute, so first ingest is slow).
VOYAGE_KEY=
# OpenRouter: every LLM call goes through it (a few cents per research run).
OPENROUTER_API_KEY=

# ---- Sign-in and credits (leave empty for open local development) -----------
# Setting the anon (publishable) key turns on Google sign-in and daily credits.
# In production the server refuses to start without it unless ALLOW_OPEN_ACCESS=1.
SUPABASE_ANON_KEY=
ALLOW_OPEN_ACCESS=

# ---- Models ------------------------------------------------------------------
SIGNAL_LLM_MODEL=anthropic/claude-sonnet-4.6
SIGNAL_LLM_TIMEOUT_MS=90000
SIGNAL_LLM_RETRIES=1
SIGNAL_AUDIO_MODEL=google/gemini-2.5-flash
# Recent news costs extra per run; set to 1 to enable.
SIGNAL_NEWS_ENABLED=
SIGNAL_NEWS_MODEL=google/gemini-2.5-flash
# Your site, sent to OpenRouter as HTTP-Referer for app attribution (default https://synthetick.org).
OPENROUTER_REFERER=

# ---- Market data (all optional, bring your own) ------------------------------
# Crypto works without a key on the public CoinGecko tier; a key raises limits.
COINGECKO_KEY=
# Equities/ETFs: Financial Modeling Prep. Check its terms before you display data publicly.
FMP_KEY=
# Pre-IPO company data (Sacra). Optional and metered.
SACRA_API_KEY=
# YouTube transcripts. Without it, extraction falls back to a web-search model.
YTSCRIBE_API_KEY=

# ---- Data display policy (runtime/display-policy.ts; all off by default) -------
# Off: stock/ETF market data, ETF holdings, vendor descriptions and FMP logos are hidden and FMP is not called at runtime; 1 shows them (needs FMP's display licence).
DISPLAY_FMP_DATA=
# Off: pre-IPO valuations, price per share and Sacra descriptions are hidden; 1 shows them (only if your Sacra licence covers public display).
DISPLAY_SACRA_DATA=
# Off: /v1, MCP and X bot replies carry no third-party market data or vendor logos (market_note says so); 1 relays it with attribution (needs vendor redistribution rights).
API_RELAY_MARKET_DATA=

# ---- Server ------------------------------------------------------------------
PORT=8787
# Client IP for per-IP rate limits. On Railway this is automatic: the edge address,
# or Cloudflare's visitor header when the edge address is a Cloudflare IP. Elsewhere,
# set the number of proxies in front of the app (1 = one proxy). Empty = socket address.
# On Railway leave it empty: a number is ignored there (it would group every visitor behind Cloudflare).
TRUST_PROXY=
# Optional, Railway only: ORIGIN_LOCK=cloudflare refuses traffic that did not come through Cloudflare.
ORIGIN_LOCK=
# Accounts the API never accepts (not Google) are removed hourly on the deployed server.
# AUTH_PRUNE_INTERVAL_MIN=0 turns it off; AUTH_PRUNE_DRY_RUN=1 only counts.
AUTH_PRUNE_INTERVAL_MIN=
AUTH_PRUNE_DRY_RUN=
AUTH_PRUNE_MAX_PER_RUN=
# Comma-separated exact origins allowed to call /v1 and /mcp from a browser. Empty = none.
CORS_ORIGINS=
# Rate limits (defaults in server/ratelimit.ts).
RATE_IP_PER_MIN=
MAX_CONCURRENT_RUNS=
# Uncharged LLM calls (/api/thesis + /api/extract): per user per UTC day (default 40), all users per day (default 1500).
RATE_LLM_PER_USER_DAY=
RATE_LLM_GLOBAL_PER_DAY=
# Automatic credit refunds after a failed run, per user per UTC day (default 3).
REFUNDS_PER_USER_DAY=
# Concurrent /api/extract requests: server-wide (default 4) and per user (default 1).
EXTRACT_MAX_CONCURRENT=
EXTRACT_MAX_CONCURRENT_PER_USER=
# Open HTTP connections cap (default 1000).
SERVER_MAX_CONNECTIONS=
# Sign-in providers the API accepts, comma-separated (default google; anonymous is always refused).
AUTH_PROVIDERS=

# ---- X (Twitter) account linking and bot (optional) --------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URL=
# Random 32+ character string for the X link state key. Optional: without it the key is derived from SUPABASE_SERVICE_KEY.
X_STATE_SECRET=
X_BOT_BEARER=
X_BOT_POLL_SECONDS=
# Per-mention deadline in seconds (default 240) and posts per UTC day (default 300).
X_BOT_MENTION_TIMEOUT_SECONDS=
X_BOT_MAX_REPLIES_PER_DAY=
# Absolute path to a system ffmpeg for X video transcription (default: the ffmpeg-static binary).
FFMPEG_PATH=

# ---- Ingest knobs (optional) -------------------------------------------------
# Cheapest honest start: CRYPTO_TOP_N=200 npm run ingest:crypto
CRYPTO_TOP_N=
CRYPTO_DETAIL_BUDGET=
