    "test:security": "tsx runtime/test-security.ts",
    "test:x-video": "tsx runtime/test-x-video.ts",
    "typecheck": "tsc --noEmit",
    "test:regression": "tsx runtime/test-regression.ts",
    "test:market": "tsx runtime/test-market.ts",
    "serve": "npm run dev",
    "test:prompts": "tsx runtime/test-prompts.ts",
    "test:similar": "tsx runtime/test-similar.ts",
    "test:shorts": "tsx runtime/test-shorts.ts",
    "test:matrix": "tsx runtime/test-matrix.ts",
    "test:models": "tsx runtime/test-models.ts",
    "test:flow-report": "tsx runtime/test-flow-report.ts",
