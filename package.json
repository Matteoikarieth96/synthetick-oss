    "ingest:equities": "tsx ingest/run-equities.ts",
    "ingest:preipo": "tsx ingest/run-preipo.ts",
    "ingest:metrics": "tsx ingest/run-metrics.ts",
    "backfill:prices": "tsx ingest/backfill-prices.ts",
    "archive:fmp": "tsx ingest/archive-fmp.ts",
    "backfill:websites": "tsx ingest/backfill-websites.ts",
    "backfill:logos": "tsx ingest/backfill-logos.ts",
    "load:private-data": "tsx ingest/load-private-data.ts",
    "universe:robinhood": "tsx ingest/robinhood-universe.ts",
    "snapshot:market": "tsx ingest/snapshot-market.ts",
    "enrich:descriptions": "tsx ingest/enrich-descriptions.ts",
    "embed": "tsx ingest/embeddings/run-embed.ts",
    "test:candidates": "tsx runtime/test-candidates.ts",
    "test:credits": "tsx runtime/test-credits.ts",
    "test:requirements": "tsx runtime/test-requirements.ts",
