# Sailor agent environment
#
# RPC configuration — two patterns, pick one:
#
# Option A: single active chain (simplest)
RPC_URL=https://your-rpc-endpoint
# CHAIN_ID=8453   # set after choosing your chain in Stage 1
#
# Option B: per-chain endpoints (multi-chain projects, or if you prefer explicit names)
# Set CHAIN_ID to the chain sailor run uses; omit RPC_URL if all chains have a specific var.
# ETH_MAINNET_RPC_URL=https://your-ethereum-endpoint
# OPTIMISM_RPC_URL=https://your-optimism-endpoint
# BSC_RPC_URL=https://your-bsc-endpoint
# UNICHAIN_RPC_URL=https://your-unichain-endpoint
# WORLD_RPC_URL=https://your-world-chain-endpoint
# HYPEREVM_RPC_URL=https://your-hyperevm-endpoint
# UNICHAIN_SEPOLIA_RPC_URL=https://your-unichain-sepolia-endpoint
# MEGAETH_RPC_URL=https://your-megaeth-endpoint
# ROBINHOOD_RPC_URL=https://your-robinhood-endpoint
# BASE_RPC_URL=https://your-base-endpoint
# ARBITRUM_RPC_URL=https://your-arbitrum-endpoint
# BASE_SEPOLIA_RPC_URL=https://your-base-sepolia-endpoint
# ARBITRUM_SEPOLIA_RPC_URL=https://your-arbitrum-sepolia-endpoint
# SEPOLIA_RPC_URL=https://your-eth-sepolia-endpoint

# Optional: non-interactive passphrase (CI, GitHub Actions, launchd, systemd)
# SAIL_PASSPHRASE=change-me-to-a-strong-passphrase

# ── sail-agent strategy secrets (put real values in .sail/.env.local) ────────
# SyntheTick public API key (mint one in the SyntheTick app, Settings -> API)
SYNTHETICK_API_KEY=stk_...
# OpenRouter key for the daily thesis call
OPENROUTER_API_KEY=sk-or-...
# X API app bearer token for recent-search news (X_BOT_BEARER also accepted)
X_BEARER_TOKEN=...
